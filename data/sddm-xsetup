#!/bin/sh
# Runs (as root) before the SDDM login screen appears, on X11.
# Puts every connected screen on its own best mode: its preferred (native) resolution at the
# highest refresh rate that resolution offers, e.g. 1920x1200 at 165 Hz instead of 60.

[ -x /usr/share/sddm/scripts/Xsetup ] && /usr/share/sddm/scripts/Xsetup

command -v xrandr >/dev/null 2>&1 || exit 0

xrandr --query 2>/dev/null | awk '
    / connected/ { out = $1; next }
    /^[^ ]/      { out = "" }
    out != "" && /\+/ && !(out in done) {
        # the line with "+" is the preferred (native) mode; pick its fastest refresh rate
        best = 0
        for (i = 2; i <= NF; i++) { r = $i; gsub(/[*+]/, "", r); if (r + 0 > best) { best = r + 0; rate = r } }
        print out, $1, rate
        done[out] = 1
    }' | while read -r out mode rate; do
    xrandr --output "$out" --mode "$mode" --rate "$rate" 2>/dev/null || true
done
exit 0
