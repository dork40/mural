#!/bin/sh
# Runs (as root) before the SDDM login screen appears, on X11.
# Sets the screen mode picked in Mural's Login screen tab (/etc/mural/login-display), e.g.
# "1920x1200 165". With "auto", or if that mode isn't there, every connected screen goes on its
# preferred (native) resolution at the highest refresh rate that resolution offers.

[ -x /usr/share/sddm/scripts/Xsetup ] && /usr/share/sddm/scripts/Xsetup

command -v xrandr >/dev/null 2>&1 || exit 0

want=auto
wrate=max
[ -r /etc/mural/login-display ] && read -r want wrate < /etc/mural/login-display

xrandr --query 2>/dev/null | awk -v want="$want" -v wrate="${wrate:-max}" '
    function fastest(   i, r, best, rate) {
        best = 0
        for (i = 2; i <= NF; i++) { r = $i; gsub(/[*+]/, "", r); if (r + 0 > best) { best = r + 0; rate = r } }
        return rate
    }
    function closest(target,   i, r, d, bd, rate) {
        bd = 1e9
        for (i = 2; i <= NF; i++) { r = $i; gsub(/[*+]/, "", r); if (r == "") continue
            d = r - target; if (d < 0) d = -d; if (d < bd) { bd = d; rate = r } }
        return rate
    }
    / connected/ { out = $1; next }
    /^[^ ]/      { out = "" }
    out == ""    { next }
    # the line with "+" is the preferred (native) mode
    /\+/ && !(out in native) { native[out] = $1 " " fastest() }
    want != "auto" && $1 == want && !(out in picked) {
        picked[out] = $1 " " (wrate == "max" ? fastest() : closest(wrate + 0))
    }
    END { for (o in native) print o, (o in picked ? picked[o] : native[o]) }
' | while read -r out mode rate; do
    xrandr --output "$out" --mode "$mode" --rate "$rate" 2>/dev/null || true
done
exit 0
